# Copy to .env and fill in. Secrets live here and nowhere else — the app's
# config table stores only which non-secret provider/model is selected.

# --- Azure OpenAI via the UL AI proxy ---------------------------------------
# Bearer-authed, OpenAI-compatible at {base}/v1/chat/completions and
# Anthropic-compatible at {base}/v1/messages (used by the claude CLI harness).
# Either the bare root or a /v1-suffixed URL works.
ULMAIPROXY_BASE_URL=https://your-proxy.example
ULMAIPROXY_AUTH_TOKEN=
# Optional: pre-select a deployment before anything is chosen in the UI.
ULMAIPROXY_MODEL=

# --- SIS fastLLM gateway -----------------------------------------------------
# Assumed OpenAI-compatible until SIS confirms otherwise; every assumption about
# this gateway is isolated in backend/llm/fastllm.py.
FASTLLM_BASE_URL=
FASTLLM_API_KEY=
FASTLLM_MODEL=
# Set to 0 if the gateway's models reject response_format json_schema. The
# client also demotes itself automatically on the first rejection.
FASTLLM_JSON_SCHEMA=1

# --- Storage -----------------------------------------------------------------
# SQLite file and the per-chat-session workspaces.
SCREENING_DB=./data/screening.db
CHAT_WORKSPACE_ROOT=./data/chat

# --- Evaluation batching -----------------------------------------------------
# Candidates per batch, and the pause between batches so a rate-limit window
# can refill.
BATCH_SIZE=30
BATCH_DELAY_SECONDS=30

# --- Bias audit --------------------------------------------------------------
AUDIT_CORPUS_DIR=./test-resumes/SWE_pdf
